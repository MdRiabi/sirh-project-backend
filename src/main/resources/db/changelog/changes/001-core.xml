<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Departement -->
    <changeSet id="001-01-create-table-departements" author="mohamed riaby">
        <createTable tableName="departements">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nom" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="manager_id" type="UUID"/>
            <column name="reference" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_departements_reference"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Employe (PK UUID généré applicativement, cf. GenerationType.UUID) -->
    <changeSet id="001-02-create-table-employes" author="mohamed riaby">
        <createTable tableName="employes">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="matricule_interne" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="matricule_cnss" type="VARCHAR(255)"/>
            <column name="matricule_paie" type="VARCHAR(255)"/>
            <column name="nom" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="prenom" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="departement_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_employes_departement" references="departements(id)"/>
            </column>
            <column name="type_contrat" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="date_embauche" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="date_fin_contrat" type="DATE"/>
            <column name="solde_conges_jours" type="DECIMAL"/>
            <column name="actif" type="BOOLEAN"/>
            <column name="reference" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_employes_reference"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Contrat -->
    <changeSet id="001-03-create-table-contrats" author="mohamed riaby">
        <createTable tableName="contrats">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employe_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="date_debut" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="date_fin" type="DATE"/>
            <column name="statut" type="VARCHAR(20)" defaultValue="EN_COURS">
                <constraints nullable="false"/>
            </column>
            <column name="motif_fin" type="VARCHAR(30)"/>
            <column name="reference" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_contrats_reference"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Utilisateur (OneToOne vers Employe -> contrainte d'unicité requise sur employe_id) -->
    <changeSet id="001-04-create-table-utilisateurs" author="mohamed riaby">
        <createTable tableName="utilisateurs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employe_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_utilisateurs_employe" references="employes(id)"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="compte_actif" type="BOOLEAN"/>
            <column name="dernier_login" type="TIMESTAMP"/>
            <column name="echecs_login_consecutifs" type="INT"/>
            <column name="verrouille_jusqu_a" type="TIMESTAMP"/>
            <column name="reference" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_utilisateurs_reference"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- @OneToOne Utilisateur.employe : addUniqueConstraint classique bloquerait la
         réattribution d'un compte après soft delete (cf. règle BaseEntity, CLAUDE.md)
         -> index unique partiel (WHERE deleted_at IS NULL) plutôt qu'une contrainte
         UNIQUE standard ; hors support portable de createIndex, d'où le <sql> brut. -->
    <changeSet id="001-05-unique-index-utilisateurs-employe-id" author="mohamed riaby">
        <sql>CREATE UNIQUE INDEX uq_utilisateurs_employe_id ON utilisateurs(employe_id) WHERE deleted_at IS NULL;</sql>
        <rollback>
            <sql>DROP INDEX uq_utilisateurs_employe_id;</sql>
        </rollback>
    </changeSet>

