<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- ParametreGlobal -->
    <changeSet id="002-01-create-table-parametres-globaux" author="mohamed riaby">
        <createTable tableName="parametres_globaux">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="cle" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="valeur" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(20)" defaultValue="DECIMAL">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="modifie_par_id" type="UUID"/>
            <column name="reference" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_parametres_globaux_reference"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
